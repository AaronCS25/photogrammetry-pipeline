Bootstrap: localimage
From: base.sif

# =============================================================================
# ETAPA 2/2: imagen final — base.sif + OpenMVS 2.3.0 (CUDA).
#
#   apptainer build base.sif base.def                       (etapa 1, ~1-1.5 h)
#   apptainer build photogrammetry.sif photogrammetry.def   (etapa 2, ~15-30 min)
#
# Notas de build (aprendidas a golpes):
#   - OpenMVS_USE_PYTHON=OFF: los bindings Python exigen python3-dev y
#     Boost.Python (REQUIRED en su CMake); solo usamos los binarios CLI.
#   - CUDA_CUDA_LIBRARY -> stub de libcuda.so: el nodo maestro no tiene GPU ni
#     driver NVIDIA, por lo que se linkea contra el stub que trae el toolkit
#     (/usr/local/cuda/lib64/stubs). En runtime, `apptainer exec --nv` inyecta
#     la libcuda.so.1 real del nodo GPU.
# =============================================================================

%labels
    Author  UTEC PFC-II Photogrammetry
    Purpose ffmpeg + COLMAP + OpenMVS pipeline (CUDA)

%post
    set -e
    export DEBIAN_FRONTEND=noninteractive
    J=8
    CUDA_ARCHS="75;80;86"

    mkdir -p /opt/src
    cd /opt/src

    git clone --depth 1 https://github.com/cdcseacave/VCG.git /opt/vcglib
    git clone --branch v2.3.0 --depth 1 --recursive https://github.com/cdcseacave/openMVS.git
    cmake -S openMVS -B openMVS/build -GNinja \
        -DCMAKE_BUILD_TYPE=Release \
        -DOpenMVS_USE_CUDA=ON \
        -DOpenMVS_USE_PYTHON=OFF \
        -DVCG_ROOT=/opt/vcglib \
        -DCUDA_CUDA_LIBRARY=/usr/local/cuda/lib64/stubs/libcuda.so \
        -DCMAKE_CUDA_ARCHITECTURES="${CUDA_ARCHS}"
    ninja -C openMVS/build -j${J} install

    cd /
    rm -rf /opt/src /opt/vcglib

%environment
    export LC_ALL=C
    # OpenMVS instala sus binarios en /usr/local/bin/OpenMVS
    export PATH=/usr/local/bin/OpenMVS:$PATH

%test
    set -e
    command -v ffmpeg
    command -v colmap
    command -v python3
    python3 -c "import yaml"
    test -x /usr/local/bin/OpenMVS/DensifyPointCloud
    test -x /usr/local/bin/OpenMVS/ReconstructMesh
    test -x /usr/local/bin/OpenMVS/RefineMesh
    test -x /usr/local/bin/OpenMVS/TextureMesh
    test -x /usr/local/bin/OpenMVS/InterfaceCOLMAP
    echo "OK: ffmpeg + COLMAP + OpenMVS + Python listos"

%runscript
    exec "$@"

%help
    Imagen con ffmpeg, COLMAP (CUDA) y OpenMVS (CUDA) para el pipeline de
    fotogrametría. Ejemplos:
      apptainer exec --nv photogrammetry.sif colmap -h
      apptainer exec --nv photogrammetry.sif python3 -m pipeline run --config <cfg> --scene <escena>
    El flag --nv es necesario en nodos GPU.
