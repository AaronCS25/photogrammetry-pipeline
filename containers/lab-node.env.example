# Copy outside the Git checkout, e.g. /data/photogrammetry/node.env (chmod 600).
IMAGE=photogrammetry:l507-v1-pycolmap
PG_NODE_TAG=REPLACE_WITH_NODE_TAG
PG_DATA_ROOT=/data/photogrammetry
PG_REQUIRE_MOUNT=/data
PG_MIN_FREE_GIB=20
PG_CPUS=8
PG_MEMORY=48g
PG_QUIET_ENTRYPOINT=1
PG_NETWORK=none
PG_EXPECTED_IMAGE_ID=sha256:1a3c25a01680253192d7b95bb57abb3c2a680a1db8d9888c6fe533fcf08e98e0
PG_SEG_IMAGE=photogrammetry-seg:l507-v1
# Obtain from docker image inspect after build/load, and verify release checksum.
PG_SEG_IMAGE_ID=REPLACE_WITH_CERTIFIED_SEGMENTATION_IMAGE_ID
